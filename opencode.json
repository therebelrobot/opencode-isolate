{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4-flash",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "nc *": "deny",
      "ssh *": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow"
    },
    "edit": "allow",
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny" },
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny"
  },
  "agent": {
    "headless": {
      "description": "Non-interactive profile for CI/scripted runs (no TTY to answer bash 'ask' prompts). Invoke with `opencode run --agent headless ...`.",
      "permission": {
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        }
      }
    }
  }
}
