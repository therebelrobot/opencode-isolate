# Copy to .env and fill in.
# Use a dedicated OpenRouter key created via the Provisioning/Management API
# with a hard `limit` (e.g. limit: 5, limit_reset: "daily") - see README.
OPENROUTER_API_KEY=

# Pin this once you've verified a build (e.g. 1.18.4) instead of tracking latest.
OPENCODE_VERSION=latest

# Seconds between poller checks of GET /api/v1/key (openrouter-usage.log).
POLL_INTERVAL=60
