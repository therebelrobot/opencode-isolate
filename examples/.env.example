# Copy to .env and fill in.
# Use a dedicated OpenRouter key created via the Provisioning/Management API
# with a hard `limit` (e.g. limit: 5, limit_reset: "daily") - see the
# source repo's README.
OPENROUTER_API_KEY=

# Pin to a released minor, e.g. 1.2 - see the source repo's README
# ("Consuming these images elsewhere") for how to find current versions and
# verify provenance before pulling. Don't leave this unset; there is no
# `latest` tag pre-1.0.
ISOLATE_OPENCODE_TAG=

# Seconds between poller checks of GET /api/v1/key (openrouter-usage.log).
POLL_INTERVAL=60
